# Defaults run on loopback with no external accounts. Set through a private .env.
APP_ORIGIN=http://localhost:8080
CAUCHE_PORT=8080
# This bootstrap database password is isolated inside the Compose network.
# Replace before first boot of a non-local installation, using URL-safe characters.
POSTGRES_PASSWORD=
# Optional Fernet key for encryption at rest. Required to save demo credentials.
CAUCHE_MASTER_KEY=
LOG_RETENTION_DAYS=90
