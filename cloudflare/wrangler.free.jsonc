{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "cauche-pulse",
  "main": "./src/free-worker.mjs",
  "compatibility_date": "2026-11-20",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "preview_urls": false,
  "triggers": { "crons": ["*/15 * * * *"] },
  "assets": {
    "directory": "../frontend/dist-free",
    "binding": "ASSETS",
    "run_worker_first": true,
    "not_found_handling": "single-page-application"
  },
  "hyperdrive": [{ "binding": "CAUCHE_DB", "id": "dd00a371443a4f73a4511dcada5fe35d" }],
  "ratelimits": [
    { "name": "LOGIN_LIMIT", "namespace_id": "7192001", "simple": { "limit": 8, "period": 60 } },
    { "name": "VENUE_LIMIT", "namespace_id": "7192002", "simple": { "limit": 12, "period": 60 } }
  ]
}
