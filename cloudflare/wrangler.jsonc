{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "cauche-pulse",
  "main": "./src/worker.mjs",
  "compatibility_date": "2026-11-19",
  "workers_dev": true,
  "preview_urls": false,
  "containers": [
    {
      "class_name": "CaucheRuntime",
      "scheduling_policy": "durable_object",
      "images": {
        "app": {
          "dockerfile": "../Dockerfile.cloudflare",
          "build_context": ".."
        }
      }
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "CAUCHE_RUNTIME",
        "class_name": "CaucheRuntime"
      }
    ]
  },
  "exports": {
    "CaucheRuntime": {
      "type": "durable-object",
      "storage": "sqlite"
    }
  },
  "triggers": {
    "crons": ["* * * * *"]
  }
}
